# Public site URL used for canonical links, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://hamzadaniyal.com

# Required for the contact form — Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=
# Sender shown on the brief emails. Must be on a domain verified in Resend
# (verify hamzadaniyal.com there). Without it, Resend's test sender is used,
# which can only deliver to the email address that owns the Resend account.
RESEND_FROM="Hamza Daniyal Portfolio <hello@hamzadaniyal.com>"

# Optional — Steam Web API key (https://steamcommunity.com/dev/apikey).
# Without it /gaming uses your public profile (persona, avatar, most-played games).
# With it you also get owned-game count, total hours, recently played and Steam level.
# Server-only: never prefix with NEXT_PUBLIC_.
STEAM_API_KEY=
